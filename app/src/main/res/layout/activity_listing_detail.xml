<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- NEW Image Carousel Container -->
        <FrameLayout
            android:id="@+id/flCarouselContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:visibility="gone">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerCarousel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- Simple manual indicator: e.g. "1 / 3" -->
            <TextView
                android:id="@+id/tvCarouselIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/rounded_tag_primary"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/carousel_indicator_placeholder"
                android:elevation="4dp"/>
        </FrameLayout>

        <!-- Padding Container for existing details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDetailRejectionReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rejection_reason_placeholder"
                android:textColor="@color/error"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvDetailPostNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bb_1001"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/rounded_tag_primary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="8dp"/>

                <ImageView
                    android:id="@+id/ivFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:contentDescription="@string/save_to_favorites"
                    android:padding="8dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailRent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvDetailTypeGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDetailLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:drawablePadding="8dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenities"
                android:textColor="@color/on_surface"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvDetailAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:textColor="@color/on_surface"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="24dp"/>

            <!-- Landlord Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivDetailLandlordAvatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/bashabhai_logo"
                        android:scaleType="centerCrop"
                        app:cornerSize="22dp"
                        android:contentDescription="@string/landlord_avatar"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/posted_by_landlord"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/tvDetailLandlordName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface"/>

                        <TextView
                            android:id="@+id/tvDetailLandlordRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 0.0 (0)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#F57F17"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailLandlordVerified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/verified"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#388E3C"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reviews Section -->
            <LinearLayout
                android:id="@+id/llReviewsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/landlord_reviews"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWriteReview"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/write_review"
                        android:textColor="@color/primary"
                        android:visibility="gone"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvNoReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_reviews_yet"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAllReviews"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_all_reviews"
                    android:textColor="@color/primary"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/call"
                    app:icon="@android:drawable/ic_menu_call"
                    app:iconGravity="textStart"
                    app:backgroundTint="#4CAF50"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSMS"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/whatsapp"
                    app:icon="@drawable/ic_whatsapp"
                    app:iconGravity="textStart"
                    app:backgroundTint="#25D366"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMap"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/view_on_map"
                app:icon="@android:drawable/ic_dialog_map"
                app:iconGravity="textStart"
                app:backgroundTint="#FF9800"
                app:cornerRadius="8dp"/>

            <!-- Owner Controls (Landlord/Admin) -->
            <LinearLayout
                android:id="@+id/llOwnerControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleRented"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/mark_as_rented"
                    app:backgroundTint="#9C27B0"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditListing"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/edit_listing"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconGravity="textStart"
                    app:backgroundTint="#2196F3"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteListing"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/delete_listing"
                    app:backgroundTint="#D32F2F"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <!-- Admin Controls -->
            <LinearLayout
                android:id="@+id/llAdminControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApproveListing"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:layout_height="56dp"
                    android:text="@string/approve"
                    app:backgroundTint="#388E3C"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRejectListing"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_height="56dp"
                    android:text="@string/reject"
                    app:backgroundTint="#D32F2F"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
