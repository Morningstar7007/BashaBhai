<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="8dp"/>

            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="Save to Favorites"
                android:padding="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailRent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#388E3C"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvDetailTypeGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDetailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:drawablePadding="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amenities:"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvDetailAmenities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description:"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Call Landlord"
                android:backgroundTint="#4CAF50"/>

            <Button
                android:id="@+id/btnSMS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Send SMS"
                android:backgroundTint="#2196F3"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View on Map"
            android:backgroundTint="#FF9800"/>

        <!-- Owner Controls (Landlord/Admin) -->
        <LinearLayout
            android:id="@+id/llOwnerControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnToggleRented"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mark as Rented"
                android:backgroundTint="#9C27B0"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnDeleteListing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Listing"
                android:backgroundTint="#D32F2F"/>
        </LinearLayout>

        <!-- Admin Controls -->
        <LinearLayout
            android:id="@+id/llAdminControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnApproveListing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Approve Listing"
                android:backgroundTint="#388E3C"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
