<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Admin Moderation Panel"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@color/primary"
        android:padding="20dp"/>

    <!-- Tab Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="2"
        android:background="@color/surface">

        <!-- Default to ACTIVE state styling for Pending Posts -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabListings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Pending Posts"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:strokeColor="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabVerifications"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Verifications"
            android:textColor="@color/on_surface"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/text_secondary"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Pending Listings View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPendingListings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"/>

        <!-- Pending Verifications View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPendingVerifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvNoPending"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No pending items awaiting review."
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone"/>

    </FrameLayout>

</LinearLayout>
